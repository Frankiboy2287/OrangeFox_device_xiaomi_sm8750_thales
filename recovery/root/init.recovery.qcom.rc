# ===========================================================================
# DIAGNOSTIC (minimal-boot) variant — 仅供定位 fox_14.1 卡 logo 的问题。
# 策略：把启动链剪到 koaaN(OnePlus15, fox_14.1 可正常启动)同款形态：
#   * 不在 on fs 提前 start qseecomd / wait ssd / 绑 persist / install_keyring
#   * 不 import wifi.rc（本轮不需要 WLAN，减少变量）
#   * 不自动跑 odm.variant-script 与 odm HAL（weaver/vibratorfeature/touch_report）
#   * 暂不挂 modem/adsp —— 先看能否进橙狐主界面 + adbd
# 若此版本能进主界面 → 再逐步加回 crypto/解密链，二分定位。
# ===========================================================================

on early-fs
    write /proc/sys/walt/sched_lib_name "recovery,magiskboot,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255

on init
    setprop prepdecrypt.setpatch true

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1

on boot
    setprop sys.usb.config adb

# ---- 以下整段在诊断版中停用（保留注释便于后续逐块加回） ----
